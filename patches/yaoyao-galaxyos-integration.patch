+import { homedir } from "node:os";
 export function bootstrapYaoyao(api, config) {
+    // v1.9.2: Merge plugin config from disk (OpenClaw may not pass entries.*.config correctly)
+    try {
+        const cfgPath = join(homedir(), ".openclaw", "openclaw.json");
+        if (existsSync(cfgPath)) {
+            const raw = readFileSync(cfgPath, "utf-8");
+            const root = JSON.parse(raw);
+            const diskCfg = root?.plugins?.entries?.["yaoyao-memory"]?.config;
+            if (diskCfg && typeof diskCfg === "object") {
+                config = { ...diskCfg, ...config };
+                // Disk config takes precedence for bridge/embedding settings
+                if (diskCfg.celiaBridge) config.celiaBridge = diskCfg.celiaBridge;
+                if (diskCfg.embedding) config.embedding = diskCfg.embedding;
+                if (diskCfg.llm) config.llm = diskCfg.llm;
+            }
+        }
+    } catch (e) {
+        // Non-fatal — fall back to whatever config was passed in
+        api.logger.debug?.("[yaoyao-memory] Failed to merge disk config: " + (e instanceof Error ? e.message : String(e)));
+    }
     const pluginVersion = readPluginVersion();
     const audit = createAuditLog(config.memoryDir || ".", api.logger, { bufferSize: 50, flushIntervalMs: 5000 });
     const cap = runInstallCheck();
